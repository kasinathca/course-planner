{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FFCS Studio local slot calendar schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campus",
    "semester_label",
    "timezone",
    "verification_status",
    "slots"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "campus": {
      "type": "string"
    },
    "semester_label": {
      "type": "string"
    },
    "timezone": {
      "const": "Asia/Kolkata"
    },
    "verification_status": {
      "enum": [
        "official_verified",
        "draft_unverified"
      ]
    },
    "source_reference": {
      "type": "string"
    },
    "slots": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "day",
            "start_minute",
            "end_minute",
            "kind"
          ],
          "properties": {
            "day": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "start_minute": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440
            },
            "end_minute": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440
            },
            "kind": {
              "enum": [
                "theory",
                "lab",
                "tutorial",
                "other"
              ]
            }
          }
        }
      }
    }
  }
}
