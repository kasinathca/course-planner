{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FFCS Studio canonical curriculum catalogue v1",
  "type": "object",
  "required": ["schema_version", "programme", "courses"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "programme": {
      "type": "object",
      "required": ["programme_code", "name", "admission_batch", "revision_code", "categories"],
      "properties": {
        "programme_code": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "admission_batch": {"type": "string", "minLength": 1},
        "revision_code": {"type": "string", "minLength": 1},
        "displayed_total_milli": {"type": "integer", "minimum": 0},
        "categories": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "courses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "code", "title", "category"],
        "properties": {
          "canonical_id": {"type": "string"},
          "source_id": {"type": "string", "minLength": 1},
          "code": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "credits": {"type": ["string", "number", "null"]},
          "lecture": {"type": ["integer", "null"], "minimum": 0},
          "tutorial": {"type": ["integer", "null"], "minimum": 0},
          "practical": {"type": ["integer", "null"], "minimum": 0},
          "project": {"type": ["integer", "null"], "minimum": 0}
        },
        "additionalProperties": true
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relationship_type", "course_ids"],
        "properties": {
          "relationship_id": {"type": "string", "minLength": 1},
          "relationship_type": {"type": "string", "minLength": 1},
          "course_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": true
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["course_id"],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "course_id": {"type": "string", "minLength": 1},
          "all_of": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "any_of": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          },
          "minimum_semester": {"type": ["integer", "null"], "minimum": 1, "maximum": 10},
          "verified": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
